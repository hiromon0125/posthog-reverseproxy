{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "/static/:path(.*)",
      "dest": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "src": "/array/:path(.*)",
      "dest": "https://us-assets.i.posthog.com/array/:path"
    },
    {
      "src": "/:path(.*)",
      "dest": "https://us.i.posthog.com/:path"
    }
  ]
}
