{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "https://us-assets.i.posthog.com/static/$1"
    },
    {
      "src": "/array/(.*)",
      "dest": "https://us-assets.i.posthog.com/array/$1"
    },
    {
      "src": "/(.*)",
      "dest": "https://us.i.posthog.com/$1"
    }
  ]
}
